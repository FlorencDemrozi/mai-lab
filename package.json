{
  "name": "mmai-lab-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Website for the MMAI Lab — Multimodal AI Lab, University of Stavanger",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "astro sync && astro build",
    "test:links": "linkinator dist --recurse --skip \"^(?!http://(localhost|127.0.0.1))\" --skip \"localhost:4321\" --verbosity error",
    "test:a11y": "node scripts/a11y.mjs",
    "test:lighthouse": "lhci autorun",
    "test:contrast": "node scripts/contrast.mjs",
    "test": "npm run test:contrast && npm run test:links && npm run test:a11y"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "linkinator": "^8.1.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
