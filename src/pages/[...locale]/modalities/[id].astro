---
import Base from '../../../layouts/Base.astro';
import DeviceCard from '../../../components/DeviceCard.astro';
import Icon from '../../../components/Icon.astro';
import StatusCounts from '../../../components/StatusCounts.astro';
import { loadLab, statusCounts, type Modality } from '../../../lib/lab';
import { localeParam, LOCALES, pick, useT, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const lab = await loadLab();
  return LOCALES.flatMap((locale) =>
    lab.modalities.map((modality) => ({ params: { locale: localeParam(locale), id: modality.id }, props: { locale, modality } })),
  );
}
const { locale, modality } = Astro.props as { locale: Locale; modality: Modality };
const t = useT(locale);
const lab = await loadLab();
const name = pick(modality.data.name, locale);
const devices = lab.modality.devices(modality);
---
<Base locale={locale} segments={['modalities', modality.id]} title={name} description={pick(modality.data.subtitle, locale)}>
  <header class="wrap page-head">
    <p class="eyebrow"><Icon name={modality.data.icon} size={20} /> {t('modalities.title')}</p>
    <h1>{name}</h1>
    <p class="lede">{pick(modality.data.subtitle, locale)}</p>
    <StatusCounts counts={statusCounts(devices)} locale={locale} />
  </header>
  <div class="wrap">
    <h2 class="sr-only">{t('modality.devices')}</h2>
    <ul class="grid" role="list">{devices.map((d) => <li><DeviceCard device={d} lab={lab} locale={locale} /></li>)}</ul>
  </div>
</Base>
