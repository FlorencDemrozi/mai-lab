---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadLab } from '../lib/lab';
import { href, LANG_TAG, LOCALES, pick, useT, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Path segments after the locale, e.g. ['devices', 'optitrack']. Empty for home. */
  segments?: string[];
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  /** schema.org objects to embed as JSON-LD. */
  jsonLd?: object[];
  ogType?: 'website' | 'profile' | 'article';
}
const { locale, segments = [], title, description, jsonLd = [], ogType = 'website' } = Astro.props;
const lab = await loadLab();
const t = useT(locale);
const s = lab.settings;
const siteName = `${s.lab_name} — ${pick(s.lab_full_name, 'en')}`;
const fullTitle = title ? `${title} · ${s.lab_name}` : `${s.lab_name} — ${pick(s.lab_full_name, locale)} · ${pick(s.tagline, locale)}`;
const other: Locale = locale === 'en' ? 'no' : 'en';
const altHref = href(other, ...segments);
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(href(locale, ...segments));
// PLACEHOLDER: a generated Open Graph image per page arrives in Phase 2 (TODO-content.md).
const ogImage = abs(`${import.meta.env.BASE_URL}og-default.png`);
---
<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LANG_TAG[l]} href={abs(href(l, ...segments))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(href('en', ...segments))} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'no' ? 'nb_NO' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply a saved theme before first paint. Without JS or storage, the OS theme applies.
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <Header locale={locale} lab={lab} altHref={altHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} lab={lab} altHref={altHref} />
  </body>
</html>
<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    background: var(--accent);
    color: var(--accent-ink);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .skip:focus { top: var(--space-3); }
  main:focus { outline: none; }
</style>
