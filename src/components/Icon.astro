---
/** Inline SVG icons. Decorative unless a `label` is given. */
const paths = {
  motion: '<circle cx="12" cy="4.5" r="2"/><path d="M9 21l2-6-3-3 2-5 4 3 3 1M11 15l4 2 1 4M10 7l-4 2"/>',
  physio: '<path d="M2 12h4l2-6 3 13 3-10 2 6 1-3h5"/>',
  vision: '<path d="M2 12c2.5-5 6-7.5 10-7.5S19.5 7 22 12c-2.5 5-6 7.5-10 7.5S4.5 17 2 12Z"/><circle cx="12" cy="12" r="3.2"/>',
  audio: '<path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/>',
  location: '<circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="9.5"/>',
  medical: '<rect x="4" y="3" width="16" height="12" rx="1.5"/><path d="M12 6v6M9 9h6M9 19h6M12 15v4"/>',
  compute: '<rect x="6" y="6" width="12" height="12" rx="1.5"/><rect x="9.5" y="9.5" width="5" height="5"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 7 8.5-7"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
} as const;
export type IconName = keyof typeof paths;
interface Props {
  /** Unknown names (e.g. a typo in a modality file) fall back to the "compute" icon. */
  name: IconName | (string & {});
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: cls } = Astro.props;
const body = paths[name as IconName] ?? paths.compute;
---
<svg
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
<style>
  .icon { flex: none; vertical-align: middle; }
</style>
