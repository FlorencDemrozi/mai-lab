---
/**
 * Device status as text + shape (never colour alone). `placeholder` adds "Unconfirmed".
 */
import type { Status } from '../lib/lab';
import { useT, type Locale } from '../i18n/ui';
interface Props {
  status: Status;
  expected?: string;
  placeholder?: boolean;
  locale: Locale;
}
const { status, expected, placeholder, locale } = Astro.props;
const t = useT(locale);
const label = t(`status.${status}`);
---
<span class="badges">
  <span class={`badge badge-${status}`}>
    <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
      {status === 'installed' && <circle cx="5" cy="5" r="4" fill="currentColor" />}
      {status === 'acquiring' && <><circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M5 1.4a3.6 3.6 0 0 1 0 7.2Z" fill="currentColor" /></>}
      {status === 'planned' && <circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 1.6" />}
      {status === 'retired' && <path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.4" />}
    </svg>
    {label}{status === 'acquiring' && expected && <span class="expected"> · {t('status.expected')} {expected}</span>}
  </span>
  {placeholder && <span class="badge badge-unconfirmed" title={t('status.unconfirmedHint')}>{t('status.unconfirmed')}</span>}
</span>
<style>
  .badges { display: inline-flex; flex-wrap: wrap; gap: 0.35rem; vertical-align: middle; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.15em 0.65em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }
  .badge-installed { color: var(--status-installed); background: var(--status-installed-bg); }
  .badge-acquiring { color: var(--status-acquiring); background: var(--status-acquiring-bg); }
  .badge-planned { color: var(--status-planned); background: var(--status-planned-bg); }
  .badge-retired { color: var(--status-retired); background: var(--status-retired-bg); }
  .badge-unconfirmed {
    color: var(--unconfirmed);
    background: transparent;
    border: 1px dashed currentColor;
    font-weight: 500;
  }
  .expected { font-weight: 500; }
</style>
